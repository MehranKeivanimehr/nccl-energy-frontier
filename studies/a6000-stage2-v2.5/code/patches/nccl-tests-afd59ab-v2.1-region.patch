+        } else {
+          G.tCommitNs = -1;  // phase unknown: wait two full periods (flagged offline, no tail correction)
+        }
+        nccleSleepUntil(G.tCommitNs >= 0 ? G.tCommitNs + margin : G.tLoopEndNs + 2 * P);
+        nccleRead(G, &G.e1, &G.rc1, &G.t1a, &G.t1b);
+        // one more commit: energy from the end read to the next commit, at idle-with-context power
+        if (G.tCommitNs >= 0) nccleSleepUntil(G.tCommitNs + P + margin); else nccleSleepUntil(G.t1b + P + margin);
+        nccleRead(G, &G.ePost, &G.rcPost, &G.tPostA, &G.tPostB);
+      }
+    }
+    Barrier(args);
+    for (int i = 0; i < args->nGpus; i++) {
