+
+  // ---- NCCLE region end (all timed collectives complete on every GPU) ----
+  if (nccle) {
+    TESTCHECK(testStreamSynchronize(args->nGpus, args->streams, args->comms));
+    Barrier(args);
+    {
+      const long long P = ncclePeriodNs(), guard = 2000000LL, margin = 8000000LL;
+      for (int i = 0; i < args->nGpus; i++) {
