 #include "util.h"
 #include "../verifiable/verifiable.h"
 
+// ===== nccl-energy-frontier methodology-v2 region instrumentation (begin) =====
+// Enabled only when NCCLE_REGION_FILE is set. For each benchmarked size and
+// placement it reads the NVML cumulative energy counter of every participating
+// GPU at two synchronized boundaries that enclose exactly the timed
+// collectives (warm-up excluded), records CUDA events around the timed loop,
+// and appends one JSON record per region to NCCLE_REGION_FILE.
+#include <dlfcn.h>
+#include <time.h>
+#include <unistd.h>
+#define NCCLE_MAX_GPUS 64
+typedef void* nccleNvmlDevice_t;
+struct NccleNvml {
+  int loaded = 0, initRc = -1;
+  int (*init)(void) = nullptr;
+  int (*byPci)(const char*, nccleNvmlDevice_t*) = nullptr;
+  int (*energy)(nccleNvmlDevice_t, unsigned long long*) = nullptr;
+  int (*index)(nccleNvmlDevice_t, unsigned int*) = nullptr;
+};
+struct NccleGpu {
+  int set; int cudaDev; char pci[32]; unsigned int nvmlIndex; nccleNvmlDevice_t h; int hRc;
+  unsigned long long e0, e1; int rc0, rc1;
+  long long t0a, t0b, t1a, t1b;  // CLOCK_MONOTONIC ns before/after the start and end reads
+  float eventMs; int eventRc;
+  // v2.1: commit-aligned end read
+  int nEdges; long long edgeLo[4], edgeHi[4];     // brackets (ns) that contain a counter commit
+  long long phaseNs, bracketNs;                   // chosen commit phase (midpoint of narrowest bracket)
+  long long tLoopEndNs, tCommitNs;                // loop end (after sync) and predicted commit used for the end read
+  unsigned long long ePost; int rcPost; long long tPostA, tPostB;  // one more window to measure idle-tail power
+};
+static NccleNvml nccleNvml;
+static std::once_flag nccleOnce;
+static NccleGpu nccleGpu[NCCLE_MAX_GPUS];
+static long long nccleNowNs() { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (long long)ts.tv_sec*1000000000LL + ts.tv_nsec; }
+static void nccleLoad() {
+  void* lib = dlopen("libnvidia-ml.so.1", RTLD_NOW | RTLD_LOCAL);
+  if (!lib) return;
+  nccleNvml.init = (int(*)(void))dlsym(lib, "nvmlInit_v2");
+  nccleNvml.byPci = (int(*)(const char*, nccleNvmlDevice_t*))dlsym(lib, "nvmlDeviceGetHandleByPciBusId_v2");
+  nccleNvml.energy = (int(*)(nccleNvmlDevice_t, unsigned long long*))dlsym(lib, "nvmlDeviceGetTotalEnergyConsumption");
+  nccleNvml.index = (int(*)(nccleNvmlDevice_t, unsigned int*))dlsym(lib, "nvmlDeviceGetIndex");
+  if (nccleNvml.init && nccleNvml.byPci && nccleNvml.energy && nccleNvml.index) {
+    nccleNvml.initRc = nccleNvml.init();
+    nccleNvml.loaded = (nccleNvml.initRc == 0);
+  }
+}
+static const char* nccleRegionFile() { return getenv("NCCLE_REGION_FILE"); }
+static void nccleBindGpu(int gidx, int cudaDev) {
+  NccleGpu& G = nccleGpu[gidx];
+  if (G.set) return;
+  G.cudaDev = cudaDev; G.hRc = -1; G.nvmlIndex = 0xffffffffu;
+  if (cudaDeviceGetPCIBusId(G.pci, sizeof(G.pci), cudaDev) != cudaSuccess) strcpy(G.pci, "unknown");
+  if (nccleNvml.loaded) {
+    G.hRc = nccleNvml.byPci(G.pci, &G.h);
+    if (G.hRc == 0) nccleNvml.index(G.h, &G.nvmlIndex);
+  }
+  G.set = 1;
+}
+static void nccleRead(NccleGpu& G, unsigned long long* e, int* rc, long long* ta, long long* tb) {
+  *ta = nccleNowNs();
+  if (G.hRc == 0) *rc = nccleNvml.energy(G.h, e); else { *rc = (G.hRc == 0 ? -1 : 1000 + G.hRc); *e = 0; }
+  *tb = nccleNowNs();
+}
+static long long nccleSleepUntil(long long tNs) {
+  long long now = nccleNowNs();
+  if (tNs > now) { struct timespec ts; ts.tv_sec = (tNs - now) / 1000000000LL; ts.tv_nsec = (tNs - now) % 1000000000LL; nanosleep(&ts, nullptr); }
+  return nccleNowNs();
+}
+static long long ncclePeriodNs() { const char* e = getenv("NCCLE_COMMIT_PERIOD_MS"); return (long long)((e ? atof(e) : 100.0) * 1e6); }
+// Poll the counter (GPU idle, outside the region) to bracket counter commits.
+static void nccleProbePhase(NccleGpu& G) {
+  G.nEdges = 0; G.phaseNs = -1; G.bracketNs = -1;
+  if (G.hRc != 0) return;
+  unsigned long long v, prev = 0; long long ta, tb, prevTa = 0; int rc;
+  long long tStop = nccleNowNs() + 4 * ncclePeriodNs();
+  bool first = true;
+  while (nccleNowNs() < tStop && G.nEdges < 4) {
+    ta = nccleNowNs(); rc = nccleNvml.energy(G.h, &v); tb = nccleNowNs();
+    if (rc != 0) return;
+    if (!first && v != prev) { G.edgeLo[G.nEdges] = prevTa; G.edgeHi[G.nEdges] = tb; G.nEdges++; }
+    first = false; prev = v; prevTa = ta;
+  }
+  for (int k = 0; k < G.nEdges; k++) {
+    long long w = G.edgeHi[k] - G.edgeLo[k];
+    if (G.bracketNs < 0 || w < G.bracketNs) { G.bracketNs = w; G.phaseNs = (G.edgeLo[k] + G.edgeHi[k]) / 2; }
+  }
+}
+
+// ===== nccl-energy-frontier methodology-v2 region instrumentation (end) =====
+
 #if defined(NCCL_OS_LINUX)
 #pragma weak ncclCommWindowRegister
 #pragma weak ncclCommWindowDeregister
