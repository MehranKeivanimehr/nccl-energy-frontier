+      CUDACHECK(cudaSetDevice(args->gpus[i]));
+      G.eventRc = (int)cudaEventElapsedTime(&G.eventMs, nccleEvS[i], nccleEvE[i]);
+      CUDACHECK(cudaEventDestroy(nccleEvS[i]));
+      CUDACHECK(cudaEventDestroy(nccleEvE[i]));
+    }
+  }
   if (cudaGraphLaunches >= 1) deltaSec = deltaSec/cudaGraphLaunches;
 
   if (record) {
@@ -825,6 +934,30 @@ testResult_t BenchTime(struct threadArgs* args, ncclDataType_t type, ncclRedOp_t
 
