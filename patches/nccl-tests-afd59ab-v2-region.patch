+    Barrier(args);
+    for (int i = 0; i < args->nGpus; i++) {
+      CUDACHECK(cudaSetDevice(args->gpus[i]));
+      CUDACHECK(cudaEventCreate(&nccleEvS[i]));
+      CUDACHECK(cudaEventCreate(&nccleEvE[i]));
+      CUDACHECK(cudaEventRecord(nccleEvS[i], args->streams[i]));
+    }
+  }
+
 #if CUDART_VERSION >= 11030
   std::vector<cudaGraph_t> graphs(args->nGpus);
